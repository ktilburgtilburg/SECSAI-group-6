{
    "manifest_version": 3,
    "name": "Test Extension",
    "description": "Extension",
    "version": "2.0",
    "host_permissions": [
        "http://127.0.0.1:5000/*",
        "http://localhost:5000/*",
        "<all_urls>"
    ],
    "permissions": [
        "webNavigation"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_title": "Test Extension"
    }
}